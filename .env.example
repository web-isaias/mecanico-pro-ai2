# =====================================================
# Mecânico Pro AI — Variáveis de Ambiente (TEMPLATE)
# =====================================================
# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA faça commit do `.env` real com credenciais.

# =====================================================
# Banco de dados Prisma
# =====================================================
# ⚠️ AVISO IMPORTANTE — SQLITE E CAMINHOS RELATIVOS
# NÃO use caminho relativo (ex: "file:./db/custom.db") no SQLite!
# O Prisma resolve caminhos relativos de formas diferentes entre CLI e Runtime:
#   - Prisma CLI (studio, db push, migrate): resolve relativo a prisma/schema.prisma
#   - Prisma Client runtime (dentro do Next.js): resolve relativo a process.cwd()
# Isso cria DOIS arquivos .db diferentes → bugs tipo "usuário não encontrado"
# mesmo o Studio mostrando a tabela vazia.
#
# SOLUÇÃO: use CAMINHO ABSOLUTO. Substitua o caminho abaixo pelo caminho
# completo da pasta do seu projeto:
#
# Windows:  file:C:/Users/voce/projetos/mecanico-pro-ai/db/custom.db
# macOS:    file:/Users/voce/projetos/mecanico-pro-ai/db/custom.db
# Linux:    file:/home/voce/projetos/mecanico-pro-ai/db/custom.db
#
# Atalho para descobrir o caminho absoluto (no terminal, na pasta do projeto):
#   Windows PowerShell:  echo "file:$PWD/db/custom.db"
#   macOS/Linux:         echo "file:$(pwd)/db/custom.db"
DATABASE_URL="file:CAMINHO_ABSOLUTO_DO_PROJETO/db/custom.db"

# Produção (PostgreSQL exemplo — recomendado para deploy):
# DATABASE_URL="postgresql://user:password@localhost:5432/mecanico_pro_ai?schema=public"

# =====================================================
# NextAuth.js — Autenticação
# =====================================================
# URL pública do app (sem barra no final)
NEXTAUTH_URL="http://localhost:3000"
# Segredo JWT — gere com: openssl rand -base64 32
NEXTAUTH_SECRET="gere-um-segredo-aleatorio-aqui"

# =====================================================
# Mercado Pago — Cobrança recorrente (Subscriptions)
# =====================================================
# Pegue em: https://www.mercadopago.com.br/developers/panel/app
# Em produção, use tokens APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# ID da aplicação (opcional, para assinaturas webhooks)
MERCADOPAGO_APP_ID=""
# Flag pública que ativa o checkout real (vs modo dev de teste)
NEXT_PUBLIC_MP_CONFIGURED="false"

# =====================================================
# z-ai-web-dev-sdk (Skills de IA: LLM, VLM, ASR)
# =====================================================
# O SDK já funciona neste ambiente. Para deploy externo,
# configure as credenciais conforme a documentação do SDK.
# ZAI_API_KEY="sua-chave-aqui"
